{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexLight",
  "version": "0.1.0",
  "identifier": "com.codexlight.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodexLight",
        "width": 1320,
        "height": 860,
        "minWidth": 920,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "CodexLight tray and GUI",
    "longDescription": "Cross-platform GUI and tray status monitor for CodexLight."
  }
}
